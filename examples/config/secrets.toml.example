# Copy to secrets.toml and `chmod 600 secrets.toml`.

# Generate with:  homepage hash-password
password_hash = '$argon2id$v=19$m=19456,t=2,p=1$...'

[tokens]
# Vikunja: Settings → API Tokens, permissions tasks (read_all, update) and projects (read_all)
vikunja = "tk_..."
# Forgejo: optional, only needed for private repositories (scope read:user, read:repository)
forgejo = "..."
# GitHub: optional; a fine-grained token with no repository access enables the contribution calendar
github = "github_pat_..."
# bookmarkd v0.7.0+: on its host, `bookmarkd token create homepage` prints a read-only token
bookmarkd = "..."
# Home Assistant: Profile → Security → Long-lived access tokens
homeassistant = "..."
# Cross-device inbox: a read-write token from the inbox settings page (a write-only one can only send)
inbox = "..."
# Mail: the IMAP password. Gmail: Google 账号 → 安全 → 应用专用密码; iCloud: Apple ID → App 专用密码
mail = "..."
# DeepSeek: platform.deepseek.com → API keys
deepseek = "sk-..."
# ipv6who: only if its config.toml sets `token`
# ipv6who = "..."
